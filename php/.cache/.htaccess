# La carpeta .cache solo guarda el host y el puerto de MySQL que
# respondieron (nunca credenciales), pero no debe descargarse desde el
# navegador. Las dos directivas cubren Apache 2.4 y 2.2.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
